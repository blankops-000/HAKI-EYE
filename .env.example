# ============================================================
# HAKI-EYE — Environment Variables Reference
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
#
# PrimeCloud auto-injects DATABASE_URL and storage credentials
# at runtime in deployed environments. The VITE_* variables
# below are needed for the frontend to reach your API/services.
# ============================================================

# ----------------------------------------------------------
# DATABASE (PrimeCloud — auto-injected in production)
# ----------------------------------------------------------
# Used by your backend/API layer, NOT exposed to the browser.
DATABASE_URL=postgresql://primecloud_app:[YOUR_VAULT_SECRET]@[DB_NAME].internal:5432/appdb

# ----------------------------------------------------------
# PRIMECLOUD API (control plane / backend calls)
# ----------------------------------------------------------
PRIMECLOUD_API_TOKEN=your-primecloud-api-token-here

# ----------------------------------------------------------
# APP CONFIG (exposed to the Vite frontend via import.meta.env)
# ----------------------------------------------------------
# Base URL of your backend API — change to localhost for dev
VITE_API_BASE_URL=http://localhost:3000/api

# Runtime environment
VITE_APP_ENV=development

# App display name (used in UI titles, reports, exports)
VITE_APP_NAME=HAKI-EYE

# ----------------------------------------------------------
# PRIMESTORAGE — S3-compatible object storage
# (auto-injected in production, fill in for local dev)
# ----------------------------------------------------------
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=your-region
AWS_ENDPOINT_URL_S3=https://your-primestorage-endpoint

# ----------------------------------------------------------
# SERVER / PLATFORM
# ----------------------------------------------------------
PORT=3000
NODE_ENV=development

